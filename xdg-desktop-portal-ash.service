[Unit]
Description=FreeDesktop XDG Desktop Portal Backend for the ChromiumOS Ash DE
Documentation=man:xdg-desktop-portal-ash(8)
After=dbus.service
Wants=dbus.service

[Service]
Type=simple
ExecStart=/usr/libexec/xdg-desktop-portal-ash
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
